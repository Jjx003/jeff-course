# Copy to `.env` to configure optional features. `.env` is git-ignored.
# Everything here is optional; the app runs fine with none of it set.

# ── AI tutor (optional) ──────────────────────────────────────────────────
# Enables the "Tutor" drawer on module pages. Get a key from
# https://openrouter.ai/keys. The key stays on the machine running the
# server and is never sent to the browser. Leave unset to disable the tutor.
# OPENROUTER_API_KEY=sk-or-v1-...

# Any model slug OpenRouter serves. Defaults to openai/gpt-4o-mini.
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Point at an OpenAI-compatible endpoint instead of OpenRouter (e.g. a local
# llama.cpp or Ollama server). Defaults to https://openrouter.ai/api/v1.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# By default the tutor never sees solution.md, solution/ code, or quiz answer
# keys, so it can only hint. Set to 1 to let it read them.
# TUTOR_ALLOW_SOLUTIONS=1

# ── Paths and execution (optional) ───────────────────────────────────────
# COURSES_DIR=/path/to/courses
# DB_PATH=/path/to/jeff-course.duckdb
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
# SANDBOX_SKIP_GPU_PROBE=1
